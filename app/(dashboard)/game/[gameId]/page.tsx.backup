"use client"

import { use } from "react"
import Link from "next/link"
import { ArrowLeft, Clock, Crosshair, Shield } from "lucide-react"
import { cn } from "@/lib/utils"
import { useGame } from "@/lib/hooks/use-games"
import { useGameRounds } from "@/lib/hooks/use-rounds"
import { RoundTimeline, RoundData } from "@/components/timeline/round-timeline"
import { MetricRow } from "@/components/metrics/metric-row"

export default function GameDetailPage({
  params,
}: {
  params: Promise<{ gameId: string }>
}) {
  const { gameId } = use(params)
  const { data: game, isLoading: gameLoading } = useGame(gameId)
  const { data: rounds, isLoading: roundsLoading } = useGameRounds(gameId)

  if (gameLoading || roundsLoading) {
    return (
      <div className="h-full flex items-center justify-center">
        <div className="text-text-tertiary">Loading game data...</div>
      </div>
    )
  }

  if (!game) {
    return (
      <div className="h-full flex items-center justify-center">
        <div className="text-text-tertiary">Game not found</div>
      </div>
    )
  }

  const formatDuration = (ms: number | null) => {
    if (!ms) return "N/A"
    const minutes = Math.floor(ms / 60000)
    const seconds = Math.floor((ms % 60000) / 1000)
    return `${minutes}:${seconds.toString().padStart(2, "0")}`
  }

  // Convert rounds to timeline format
  const timelineRounds: RoundData[] = (rounds || []).map(round => ({
    roundNumber: round.round_number,
    outcome: round.winner_side === "team_a" ? "win" : round.winner_side === "team_b" ? "loss" : "neutral",
    side: round.side_a_attacking ? "attack" : "defense",
    details: {
      economy: "full", // TODO: Calculate from player economy data
      site: undefined, // TODO: Get from spike plant location
      firstDeath: round.first_blood_timestamp_ms
        ? {
            player: round.first_blood_player_id || "Unknown",
            timestamp: formatDuration(round.first_blood_timestamp_ms),
          }
        : undefined,
    },
  }))

  const attackRounds = rounds?.filter(r => r.side_a_attacking) || []
  const defenseRounds = rounds?.filter(r => !r.side_a_attacking) || []
  const attackWins = attackRounds.filter(r => r.winner_side === "team_a").length
  const defenseWins = defenseRounds.filter(r => r.winner_side === "team_a").length

  const pistolRounds = rounds?.filter(r => [1, 13].includes(r.round_number)) || []
  const pistolWins = pistolRounds.filter(r => r.winner_side === "team_a").length

  const spikePlanted = rounds?.filter(r => r.spike_planted).length || 0
  const spikeDefused = rounds?.filter(r => r.spike_defused).length || 0

  return (
    <div className="h-full overflow-auto">
      <div className="max-w-7xl mx-auto p-6 space-y-6">
        {/* Back Button */}
        <Link
          href={`/series/${game.series_id}`}
          className="inline-flex items-center gap-2 text-xs text-text-tertiary hover:text-text-primary transition-fast"
        >
          <ArrowLeft className="h-3 w-3" />
          Back to Match
        </Link>

        {/* Game Header */}
        <div className="panel">
          <div className="flex items-start justify-between mb-4">
            <div>
              <div className="text-xs text-text-tertiary mb-2">GAME {game.sequence_number}</div>
              <h1 className="text-2xl font-bold text-text-primary">{game.map_name}</h1>
            </div>
            <div className="text-right">
              <div className="text-xs text-text-tertiary mb-1">FINAL SCORE</div>
              <div className="text-2xl font-bold text-text-primary tabular-nums">
                <span className={cn(game.team_a_score > game.team_b_score ? "text-win" : "text-loss")}>
                  {game.team_a_score}
                </span>
                <span className="text-text-tertiary mx-2">—</span>
                <span className={cn(game.team_b_score > game.team_a_score ? "text-win" : "text-loss")}>
                  {game.team_b_score}
                </span>
              </div>
            </div>
          </div>

          <div className="flex items-center gap-6 text-xs text-text-tertiary">
            <div className="flex items-center gap-1">
              <Clock className="h-3 w-3" />
              <span>Duration: {formatDuration(game.duration_ms)}</span>
            </div>
            <div className="flex items-center gap-1">
              <Crosshair className="h-3 w-3" />
              <span>{rounds?.length || 0} Rounds Played</span>
            </div>
          </div>
        </div>

        {/* Quick Stats */}
        <MetricRow
          metrics={[
            {
              label: "Attack Rounds",
              value: `${attackWins}/${attackRounds.length}`,
              change: attackRounds.length > 0
                ? {
                    value: `${((attackWins / attackRounds.length) * 100).toFixed(0)}%`,
                    direction: attackWins / attackRounds.length >= 0.5 ? "up" : "down",
                  }
                : undefined,
              status: attackWins / attackRounds.length >= 0.5 ? "win" : "loss",
            },
            {
              label: "Defense Rounds",
              value: `${defenseWins}/${defenseRounds.length}`,
              change: defenseRounds.length > 0
                ? {
                    value: `${((defenseWins / defenseRounds.length) * 100).toFixed(0)}%`,
                    direction: defenseWins / defenseRounds.length >= 0.5 ? "up" : "down",
                  }
                : undefined,
              status: defenseWins / defenseRounds.length >= 0.5 ? "win" : "loss",
            },
            {
              label: "Pistol Rounds",
              value: `${pistolWins}/${pistolRounds.length}`,
              context: "Rounds 1 & 13",
              status: pistolWins >= 2 ? "win" : pistolWins === 1 ? "warning" : "loss",
            },
            {
              label: "Spike Plant/Defuse",
              value: `${spikePlanted}/${spikeDefused}`,
              context: "Plant/Defuse",
            },
          ]}
        />

        {/* Round Timeline */}
        <div className="space-y-3">
          <h2 className="label-tactical">Round-by-Round Timeline</h2>
          <RoundTimeline
            rounds={timelineRounds}
            matchTitle={`${game.map_name} — Team A vs Team B`}
          />
        </div>

        {/* Round List */}
        <div className="space-y-3">
          <h2 className="label-tactical">Round Details</h2>
          <div className="panel p-0 overflow-hidden">
            <table className="table-dense">
              <thead>
                <tr>
                  <th>Round</th>
                  <th>Side</th>
                  <th>Result</th>
                  <th>End Type</th>
                  <th className="text-right">Duration</th>
                  <th className="text-center">Spike</th>
                </tr>
              </thead>
              <tbody>
                {rounds && rounds.length > 0 ? (
                  rounds.map((round) => {
                    const won = round.winner_side === "team_a"
                    const isPistol = [1, 13].includes(round.round_number)

                    return (
                      <tr key={round.id} className="cursor-pointer">
                        <td>
                          <div className="flex items-center gap-2">
                            <span className="font-semibold">{round.round_number}</span>
                            {isPistol && (
                              <span className="text-xs text-valorant-accent uppercase">Pistol</span>
                            )}
                          </div>
                        </td>
                        <td>
                          <span className={cn(
                            "text-xs uppercase font-medium",
                            round.side_a_attacking ? "text-chart-attack" : "text-chart-defense"
                          )}>
                            {round.side_a_attacking ? "Attack" : "Defense"}
                          </span>
                        </td>
                        <td>
                          <span className={cn(
                            "text-xs uppercase font-bold",
                            won ? "text-win" : "text-loss"
                          )}>
                            {won ? "WIN" : "LOSS"}
                          </span>
                        </td>
                        <td className="text-xs text-text-secondary capitalize">
                          {round.end_type || "Unknown"}
                        </td>
                        <td className="text-right tabular-nums">{formatDuration(round.duration_ms)}</td>
                        <td className="text-center">
                          {round.spike_planted && (
                            <div className="inline-flex items-center gap-1 text-xs">
                              <Shield className={cn(
                                "h-3 w-3",
                                round.spike_defused ? "text-chart-defense" : "text-chart-attack"
                              )} />
                              <span className="text-text-tertiary">
                                {round.spike_defused ? "Defused" : "Planted"}
                              </span>
                            </div>
                          )}
                        </td>
                      </tr>
                    )
                  })
                ) : (
                  <tr>
                    <td colSpan={6} className="text-center text-text-tertiary py-8">
                      No rounds data available
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  )
}
