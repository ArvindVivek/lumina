-- Historical: pgloader config used for initial SQLite to PostgreSQL migration (Phase 1)
-- Source data now archived; tables live in lumina schema

LOAD DATABASE
    FROM sqlite:///path/to/source/valvision.db  -- archived source
    INTO postgresql://postgres:postgres@localhost:54322/postgres

WITH include drop,
     create tables,
     create indexes,
     reset sequences,
     downcase identifiers

SET work_mem to '16MB',
    maintenance_work_mem to '512MB'

EXCLUDING TABLE NAMES LIKE 'chat%', 'sqlite%'
;
